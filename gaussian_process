# !pip install gpflow tensorflow

# Step 2: Import necessary libraries
import gpflow
import tensorflow as tf
import numpy as np

# Step 3: Prepare the training data
X = np.array([[0, 0], [0, 0], [0, 0], [40, 40], [40, 40], [40, 40]])
Y = np.array([[15, 20], [-10, 5], [5, -30], [10, 40], [30, 60], [50, 50]])

# Step 4: Define the GP model
# We use the same kernel function for both outputs, but they are modeled independently.
kernel = gpflow.kernels.SharedIndependent(gpflow.kernels.SquaredExponential(), output_dim=2)
likelihood = gpflow.likelihoods.Gaussian()
# Using GPR for exact Gaussian Processes
model = gpflow.models.GPR(data=(X, Y), kernel=kernel, likelihood=likelihood)

# Step 5: Optimize the model parameters
optimizer = gpflow.optimizers.Scipy()
optimizer.minimize(model.training_loss, model.trainable_variables, options=dict(maxiter=100))

# The model is now fitted. You can make predictions using model.predict_f or model.predict_y
# For example, to predict at a new point:
Xnew = np.array([[20, 20]])  # New input features
mean, var = model.predict_y(Xnew)  # Predict mean and variance of the outputs

print(f"Predicted mean: {mean}")
print(f"Predicted variance: {var}")
